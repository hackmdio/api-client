{
  "name": "@hackmd/api",
  "version": "2.7.0",
  "description": "HackMD Node.js API Client",
  "repository": {
    "type": "git",
    "url": "https://github.com/hackmdio/api-client.git",
    "directory": "nodejs"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./raw": {
      "import": "./dist/raw.js",
      "require": "./dist/raw.cjs",
      "types": "./dist/raw.d.ts"
    },
    "./dist": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm run clean && rollup -c && pnpm check:node-types",
    "generate": "openapi-ts",
    "check:generated": "node scripts/check-generated.mjs",
    "check:node-types": "tsc --noEmit --strict --module NodeNext tests/types/raw.mts tests/types/raw.cts tests/types/playground.mts",
    "docs:build": "typedoc",
    "docs:dev": "pnpm docs:build && serve .docs-dist --listen tcp://127.0.0.1:3000",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "spec:pull": "curl -fsSL https://api.hackmd.io/v1/docs/swagger.json -o spec/hackmd-openapi.json",
    "watch": "pnpm run clean && rollup -c -w",
    "prepublishOnly": "pnpm run build",
    "lint": "eslint src --fix --ext .ts",
    "test": "jest",
    "test:e2e": "jest --config jest.e2e.config.ts"
  },
  "keywords": [
    "HackMD",
    "API Client"
  ],
  "files": [
    "dist/*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "author": {
    "name": "HackMD",
    "email": "support@hackmd.io",
    "url": "https://hackmd.io"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "devDependencies": {
    "@faker-js/faker": "^7.6.0",
    "@hey-api/openapi-ts": "0.98.2",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/eslint": "^8.21.0",
    "@types/jest": "^29.4.0",
    "@types/node": "^22.15.30",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "dotenv": "^16.0.3",
    "eslint": "^8.57.1",
    "jest": "^29.4.2",
    "msw": "^2.7.3",
    "rimraf": "^4.1.2",
    "rollup": "^4.41.1",
    "serve": "14.2.6",
    "ts-jest": "^29.4.12",
    "ts-node": "^8.8.2",
    "typedoc": "0.28.20",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "tslib": "^1.14.1"
  }
}
